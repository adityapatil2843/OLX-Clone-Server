# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (Supabase / PostgreSQL)
# DATABASE_URL — use the SESSION POOLER URL from Supabase → Settings → Database → Connection pooling
DATABASE_URL=postgresql://user:password@pooler-host:5432/dbname
# DIRECT_URL — use the DIRECT connection URL from Supabase → Settings → Database → Connection string → URI
# Required for `prisma migrate` — advisory locks don't work through PgBouncer (the pooler).
DIRECT_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres


# Security & CORS (Comma-separated origins or single origin)
CORS_ORIGIN=http://localhost:3000

# Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# ── Development-only: bypass identity (Postman testing) ───────
# Set this in your local .env ONLY. Remove before production.
DEV_TEST_CREATOR_ID=dev-creator-001

# ── Cloudinary: Media storage for Reels ──────────────────────
# Get from https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=dovrurqkt
CLOUDINARY_API_KEY=376979388622864
CLOUDINARY_API_SECRET=Bun557ug6THxVjjw5kcWxM-T8QI

# ── JWT Authentication ──────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
