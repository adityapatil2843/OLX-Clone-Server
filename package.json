{
  "name": "server",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/marketplace-flows.test.js",
    "test:reels": "node --test tests/reels.test.js",
    "test:webhook": "node --test tests/webhook.test.js",
    "test:all": "node --test tests/*.test.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "nginx:start": "node infra/nginx/start-nginx.js",
    "nginx:stop": "node infra/nginx/stop-nginx.js",
    "monitoring:up": "docker compose -f infra/monitoring/docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker compose -f infra/monitoring/docker-compose.monitoring.yml down",
    "k6:test": "k6 run tests/load/load-test.js",
    "k6:monitor": "k6 run -o experimental-prometheus-rw=http://localhost:9090/api/v1/write tests/load/load-test.js",
    "script:cleanup-otp": "node scripts/cleanup-expired-otps.js",
    "script:backfill-welcome-coins": "node scripts/backfill-welcome-coins.js",
    "build": "prisma generate",
    "prisma:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1"
  }
}
