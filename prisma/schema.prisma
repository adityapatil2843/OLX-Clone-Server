// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma7.config.ts (Prisma 7 requirement)
}

// ────────────────────────────────────────────────────────────
// Reels Module — First Slice
// Future modules (Users, Listings, Categories) will add
// foreign-key relationships via their own reviewed migrations.
// ────────────────────────────────────────────────────────────

enum ReelStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum ListingMediaType {
  IMAGE
  VIDEO
}

model Reel {
  id                 String      @id @default(uuid())

  // Creator identity — plain string until Users module exists
  // Replace with: creator   User   @relation(fields: [creatorId], references: [id])
  creatorId          String

  // Content
  caption            String?
  hashtags           String[]    @default([])
  categoryId         String?     // plain id until Categories module exists
  locationText       String?

  // Media — object-storage keys, not public URLs
  videoStorageKey    String?
  thumbnailStorageKey String?
  videoProvider      String?     // e.g. "cloudinary", "supabase-storage"
  durationMs         Int?
  width              Int?
  height             Int?

  // Future listing reference — no FK until Listings module exists
  listingId          String?

  // Lifecycle
  status             ReelStatus  @default(DRAFT)

  // Timestamps
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?   // soft-delete marker

  // ── Indexes ──────────────────────────────────────────────
  // Feed: published, non-deleted, newest first
  @@index([status, deletedAt, createdAt(sort: Desc)])
  // Creator's own reels
  @@index([creatorId, deletedAt, createdAt(sort: Desc)])
  // Moderation / status filtering
  @@index([status])
}

// ────────────────────────────────────────────────────────────
// User & Profile Module
// ────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

model User {
  id               String         @id @default(uuid())
  phone            String?        @unique
  email            String?        @unique
  passwordHash     String?
  name             String
  avatarUrl        String?
  bio              String?
  locationState    String?
  locationCity     String?
  role             UserRole       @default(USER)
  isVerifiedSeller Boolean        @default(false)
  isActive         Boolean        @default(true)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokens    RefreshToken[]
  listings         Listing[]
  wishlistItems    Wishlist[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([isActive, deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ────────────────────────────────────────────────────────────
// Category Module (Dynamic categories & hierarchy)
// ────────────────────────────────────────────────────────────

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?
  iconUrl      String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  listings     Listing[]

  @@index([slug])
  @@index([parentId, isActive, displayOrder])
  @@index([isActive, displayOrder])
}

// ────────────────────────────────────────────────────────────
// Marketplace listings and buyer wishlists
// ────────────────────────────────────────────────────────────

model Listing {
  id              String        @id @default(uuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title           String
  price           Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR") @db.VarChar(3)
  description     String?
  locationState   String?
  locationCity    String?
  locationLocality String?
  contactPhone    String
  status          ListingStatus @default(ACTIVE)
  media           ListingMedia[]
  wishlistedBy     Wishlist[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([ownerId, status, deletedAt, createdAt(sort: Desc)])
  @@index([categoryId, status, deletedAt, createdAt(sort: Desc)])
  @@index([status, deletedAt, createdAt(sort: Desc)])
  @@index([locationState, locationCity, status, deletedAt])
  @@index([price])
}

model ListingMedia {
  id            String           @id @default(uuid())
  listingId     String
  listing       Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type          ListingMediaType
  storageKey    String
  provider      String
  thumbnailKey  String?
  displayOrder  Int              @default(0)
  createdAt     DateTime         @default(now())

  @@unique([listingId, storageKey])
  @@index([listingId, displayOrder])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
}

