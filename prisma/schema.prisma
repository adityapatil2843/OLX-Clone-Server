// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma7.config.ts (Prisma 7 requirement)
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum MediaProcessingState {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ReelVisibilityState {
  DRAFT
  PUBLISHED
  ARCHIVED
  MODERATED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum ListingMediaType {
  IMAGE
  VIDEO
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum AdTargetType {
  LISTING
  REEL
}

enum AdStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum CoinTransactionType {
  WELCOME_BONUS
  BOOST_SPENT
  PURCHASE
  REFUND
}

enum MessageType {
  TEXT
  IMAGE
  LISTING_SHARE
}

enum ReportTargetType {
  USER
  LISTING
  REEL
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_SOLD
  REEL_LIKED
  REEL_COMMENTED
  REPORT_RESOLVED
}

// ────────────────────────────────────────────────────────────
// User & Profile Module
// ────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  phone            String?   @unique
  email            String?   @unique
  passwordHash     String?
  name             String
  avatarUrl        String?
  bio              String?
  locationState    String?
  locationCity     String?
  role             UserRole  @default(USER)
  isVerifiedSeller Boolean   @default(false)
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  coinsBalance     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  listings       Listing[]
  wishlistItems  Wishlist[]
  reels          Reel[]
  reelLikes      ReelLike[]
  reelComments   ReelComment[]
  savedReels     SavedReel[]
  advertisements Advertisement[]
  conversations  ConversationParticipant[]
  sentMessages   Message[]
  reportsFiled   Report[]
  auditLogs      AdminAuditLog[]
  mediaAssets    MediaAsset[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  coinTransactions CoinTransaction[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([isActive, deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model EmailOtp {
  id          String    @id @default(uuid())
  email       String
  otpHash     String
  purpose     String    @default("REGISTRATION") // REGISTRATION, LOGIN, PASSWORD_RESET
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, purpose, expiresAt])
}

// ────────────────────────────────────────────────────────────
// Category Module (Dynamic categories & hierarchy)
// ────────────────────────────────────────────────────────────

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?
  iconUrl      String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  attributes   Json? // Category-specific attribute schemas: [{ key, label, type, required, options, min, max, unit }]
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  listings Listing[]
  reels    Reel[]

  @@index([slug])
  @@index([parentId, isActive, displayOrder])
  @@index([isActive, displayOrder])
}

// ────────────────────────────────────────────────────────────
// Marketplace Listings and Media
// ────────────────────────────────────────────────────────────

model Listing {
  id               String        @id @default(uuid())
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String
  price            Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR") @db.VarChar(3)
  description      String?
  locationState    String?
  locationCity     String?
  locationLocality String?
  latitude         Float?
  longitude        Float?
  contactPhone     String
  status           ListingStatus @default(ACTIVE)
  attributes       Json? // Validated category-specific key-values e.g. { brand: "Honda", year: 2022 }
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  media           ListingMedia[]
  wishlistedBy    Wishlist[]
  reelProductTags ReelProductTag[]
  advertisements  Advertisement[]
  conversations   Conversation[]

  @@index([ownerId, status, deletedAt, createdAt(sort: Desc)])
  @@index([categoryId, status, deletedAt, createdAt(sort: Desc)])
  @@index([status, deletedAt, createdAt(sort: Desc)])
  @@index([locationState, locationCity, status, deletedAt])
  @@index([latitude, longitude])
  @@index([price])
}

model ListingMedia {
  id           String           @id @default(uuid())
  listingId    String
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type         ListingMediaType
  storageKey   String
  provider     String
  thumbnailKey String?
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())

  @@unique([listingId, storageKey])
  @@index([listingId, displayOrder])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
}

// ────────────────────────────────────────────────────────────
// Media Asset Module
// ────────────────────────────────────────────────────────────

model MediaAsset {
  id              String               @id @default(uuid())
  ownerId         String
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mediaType       String // VIDEO, IMAGE
  purpose         String // REEL_VIDEO, LISTING_IMAGE, AVATAR
  storageKey      String
  provider        String               @default("cloudinary")
  mimeType        String?
  sizeBytes       Int?
  durationMs      Int?
  width           Int?
  height          Int?
  thumbnailKey    String?
  processingState MediaProcessingState @default(PENDING)
  createdAt       DateTime             @default(now())

  reel Reel?

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([storageKey])
}

// ────────────────────────────────────────────────────────────
// Reels & Video Discovery Module
// ────────────────────────────────────────────────────────────

model Reel {
  id        String @id @default(uuid())
  creatorId String
  creator   User?  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  caption      String?
  hashtags     String[]  @default([])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locationText String?

  mediaAssetId String?     @unique
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  visibilityState ReelVisibilityState @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  taggedProducts ReelProductTag[]
  likes          ReelLike[]
  comments       ReelComment[]
  savedBy        SavedReel[]
  advertisements Advertisement[]
  reports        Report[]

  @@index([visibilityState, deletedAt, createdAt(sort: Desc)])
  @@index([creatorId, deletedAt, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([visibilityState])
}

model ReelProductTag {
  id        String   @id @default(uuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reelId, listingId])
  @@index([listingId])
}

model ReelLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reelId])
  @@index([reelId, createdAt(sort: Desc)])
}

model ReelComment {
  id        String    @id @default(uuid())
  reelId    String
  reel      Reel      @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([reelId, createdAt(sort: Desc)])
}

model SavedReel {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reelId])
  @@index([userId, createdAt(sort: Desc)])
}

// ────────────────────────────────────────────────────────────
// Coin Ledger & Boost Packages Module
// ────────────────────────────────────────────────────────────

model CoinTransaction {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  balanceAfter   Int
  type           CoinTransactionType
  reason         String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
}

model BoostPackage {
  id           String          @id @default(uuid())
  name         String
  durationDays Int
  coinsCost    Int
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  advertisements Advertisement[]

  @@index([isActive, sortOrder])
}

// ────────────────────────────────────────────────────────────
// Advertisements & Sponsored Content
// ────────────────────────────────────────────────────────────

model Advertisement {
  id         String       @id @default(uuid())
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  targetType AdTargetType
  targetId   String
  title      String       @default("Boost Campaign")
  budget     Decimal?     @db.Decimal(10, 2)
  status     AdStatus     @default(ACTIVE)

  packageId   String?
  package     BoostPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageDays Int?
  coinsSpent  Int?

  startDate  DateTime     @default(now())
  endDate    DateTime?
  stoppedAt  DateTime?

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reelId    String?
  reel      Reel?    @relation(fields: [reelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([targetType, targetId, status])
  @@index([listingId, status])
  @@index([packageId])
  @@index([status, endDate])
}

// ────────────────────────────────────────────────────────────
// Chat & Messaging Module
// ────────────────────────────────────────────────────────────

model Conversation {
  id              String    @id @default(uuid())
  listingId       String?
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  lastMessageText String?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([listingId])
  @@index([updatedAt(sort: Desc)])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)
  content        String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  @@index([conversationId, createdAt(sort: Asc)])
}

// ────────────────────────────────────────────────────────────
// Admin, Moderation & Audit Module
// ────────────────────────────────────────────────────────────

model Report {
  id              String           @id @default(uuid())
  reporterId      String
  reporter        User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType
  targetId        String
  reason          String
  details         String?
  status          ReportStatus     @default(PENDING)
  resolutionNotes String?
  resolvedAt      DateTime?
  reelId          String?
  reel            Reel?            @relation(fields: [reelId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([targetType, targetId, status])
  @@index([status, createdAt(sort: Desc)])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([type, createdAt])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newMessage        Boolean  @default(true)
  listingUpdates    Boolean  @default(true)
  reelActivity      Boolean  @default(true)
  moderationUpdates Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
